[Unit]
Description=Box Linux Policy Watcher
PartOf=box.service
After=box.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/boxctl policy monitor
ExecStop=/usr/bin/boxctl policy disable
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash

set -euo pipefail

output=""
url=""

while (($# > 0)); do
  case "$1" in
    -o)
      output="${2:?missing curl output path}"
      shift 2
      ;;
    -f|-s|-S|-L|-fsSL)
      shift
      ;;
    *)
      url="$1"
      shift
      ;;
  esac
done

if [[ -n "${MOCK_CURL_FAIL_URL:-}" && "${url}" == "${MOCK_CURL_FAIL_URL}" ]]; then
  printf 'mock curl failed for %s\n' "${url}" >&2
  exit 22
fi

if [[ -n "${MOCK_CURL_RESPONSE_FILE:-}" && -n "${output}" ]]; then
  cp -f "${MOCK_CURL_RESPONSE_FILE}" "${output}"
  exit 0
fi

printf 'mock curl has no response configured for %s\n' "${url}" >&2
exit 22
